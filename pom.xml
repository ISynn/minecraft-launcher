<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>fr.launcher</groupId>
    <artifactId>launcher</artifactId>
    <!-- Même valeur que LauncherConfig.VERSION -->
    <version>2.0.0-alpha</version>
    <name>PokeIsland Launcher (prototype)</name>

    <properties>
        <maven.compiler.release>24</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>25.0.5</javafx.version>
        <gson.version>2.14.0</gson.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all,-serial,-requires-transitive-automatic</arg>
                    </compilerArgs>
                </configuration>
                <executions>
                    <execution>
                        <!-- Les tests réseau utilisent le petit serveur HTTP du JDK : réservé aux tests. -->
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>-Xlint:all,-serial,-requires-transitive-automatic</arg>
                                <arg>--add-modules</arg>
                                <arg>jdk.httpserver</arg>
                                <arg>--add-reads</arg>
                                <arg>fr.launcher=jdk.httpserver</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- Les tests visent la logique métier : le classpath suffit, sans patcher le module. -->
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>fr.launcher/fr.launcher.Main</mainClass>
                    <options>
                        <option>--enable-native-access=javafx.graphics,fr.launcher</option>
                        <option>-Dprism.forceGPU=true</option>
                        <!-- Mesuré (étape 6) : ramasse-miettes Serial + tas plafonné = ~35 Mo de mémoire privée en moins ;
                             archive CDS créée au premier lancement = démarrage interne ~2,2 s -> ~1,5 s ensuite. -->
                        <option>-XX:+UseSerialGC</option>
                        <option>-Xmx256m</option>
                        <option>-XX:+AutoCreateSharedArchive</option>
                        <option>-XX:SharedArchiveFile=${project.build.directory}/launcher.jsa</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
